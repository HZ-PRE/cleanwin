<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CleanOptimize.App.Pages.AppsPage" FontFamily="Microsoft YaHei UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="4,2,4,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource nav.apps}" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
        <TextBlock Text="{DynamicResource apps.desc}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="1" Margin="0,18,0,0">
        <Grid Width="240" Height="36" VerticalAlignment="Center" Margin="0,0,0,8">
          <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" Padding="10,0,32,0"/>
          <TextBlock x:Name="SearchHint" Text="{DynamicResource apps.search.hint}" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="10,0,32,0" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
          <Button x:Name="ClearSearch" Content="×" FontSize="18" Style="{StaticResource LinkButton}" Width="30" Padding="0" HorizontalAlignment="Right" Visibility="Collapsed" Click="ClearSearch_Click" ToolTip="{DynamicResource ui.search.clear}"/>
        </Grid>
        <ComboBox x:Name="SortSelector" Width="120" Height="36" Margin="12,0,0,8" VerticalAlignment="Center" SelectionChanged="Sort_Changed">
          <ComboBoxItem Content="{DynamicResource apps.sort.name}" Tag="name" IsSelected="True"/>
          <ComboBoxItem Content="{DynamicResource apps.sort.size}" Tag="size"/>
          <ComboBoxItem Content="{DynamicResource apps.sort.date}" Tag="date"/>
        </ComboBox>
        <Button x:Name="BtnRefresh" Content="{DynamicResource btn.refresh}" Style="{StaticResource SecondaryButton}" Height="36" Padding="18,4" Margin="12,0,0,8" VerticalAlignment="Center" Click="BtnRefresh_Click"/>
      </WrapPanel>
    </Grid>
    <Grid Grid.Row="1" Margin="2,14,2,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="230"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource CardBorder}" Padding="10,8" Margin="0,0,18,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="12,6,12,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2.6*"/>
              <ColumnDefinition Width="1.2*"/>
              <ColumnDefinition Width="0.9*"/>
              <ColumnDefinition Width="1.1*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="AppCount" Grid.ColumnSpan="5" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
          </Grid>
          <controls:VirtualRows xmlns:controls="clr-namespace:CleanOptimize.App.Controls" x:Name="AppList" Grid.Row="1" SelectionChanged="AppList_SelectionChanged"/>
        </Grid>
      </Border>
      <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" Margin="14,8,14,8">
        <TextBlock x:Name="WaitingText" Text="{DynamicResource apps.loading}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="2,2,0,12" TextTrimming="CharacterEllipsis"/>
        <UniformGrid Columns="2">
          <Border Style="{StaticResource SkeletonRow}" Margin="0,0,14,10"/>
          <Border Style="{StaticResource SkeletonRow}"/>
          <Border Style="{StaticResource SkeletonRow}" Margin="0,0,14,10"/>
          <Border Style="{StaticResource SkeletonRow}"/>
          <Border Style="{StaticResource SkeletonRow}" Margin="0,0,14,10"/>
          <Border Style="{StaticResource SkeletonRow}"/>
          <Border Style="{StaticResource SkeletonRow}" Margin="0,0,14,10"/>
          <Border Style="{StaticResource SkeletonRow}"/>
        </UniformGrid>
      </StackPanel>
      <TextBlock x:Name="EmptyText" Text="{DynamicResource apps.empty}" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Visibility="Collapsed" VerticalAlignment="Center"/>
      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Border Style="{StaticResource CardBorder}" VerticalAlignment="Top" Padding="18">
        <StackPanel>
          <Border x:Name="AppDetailIcon" HorizontalAlignment="Left" Margin="0,0,0,14" Visibility="Collapsed"/>
          <TextBlock x:Name="AppDetailName" Text="{DynamicResource ui.select.app}" Style="{StaticResource H2Text}" TextWrapping="Wrap"/>
          <TextBlock x:Name="AppDetailMeta" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"/>
          <Button x:Name="AppUninstall" Content="{DynamicResource btn.uninstall}" Style="{StaticResource DangerGhostButton}" Margin="0,18,0,0" IsEnabled="False" Click="AppUninstall_Click"/>
          <TextBlock Text="{DynamicResource ui.uninstall.note}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,0"/>
        </StackPanel>
      </Border>
      </ScrollViewer>
    </Grid>
  </Grid>
</Page>

<Page x:Class="CleanOptimize.App.Pages.HomePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" FontFamily="Microsoft YaHei UI">
 <Page.Resources>
  <Style x:Key="HomeRow" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="6,11"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="RowBorder" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ItemHoverBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource PrimarySoftBrush}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="HomeLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style x:Key="HomeHint" TargetType="TextBlock" BasedOn="{StaticResource HomeLabel}"><Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Page.Resources>
 <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel MaxWidth="1200" Margin="4,2,4,12">
   <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,16,0"><TextBlock Text="{DynamicResource ui.home.overview}" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock x:Name="LastScanText" Text="{DynamicResource home.noscan}" Style="{StaticResource HomeHint}" Margin="0,5,0,0"/></StackPanel>
    <Button x:Name="HealthBadge" Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="10,7" VerticalAlignment="Center" MaxWidth="280" Click="Health_Click" ToolTip="{DynamicResource ui.home.score.note}">
     <WrapPanel><Ellipse x:Name="HealthDot" Width="6" Height="6" Fill="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock x:Name="HealthScoreText" Text="—" Style="{StaticResource HomeLabel}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource home.health.unit}" Style="{StaticResource HomeHint}" Margin="4,0,7,0"/><TextBlock x:Name="HealthLevelText" Text="{DynamicResource ui.home.pending}" Style="{StaticResource HomeHint}"/></WrapPanel>
    </Button>
   </Grid>
   <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,1" Padding="0,16">
    <Grid x:Name="OverviewGrid"><Grid.ColumnDefinitions><ColumnDefinition Width="7*"/><ColumnDefinition Width="5*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,18,0"><TextBlock x:Name="StatusTitle" Text="{DynamicResource home.card.junk}" Style="{StaticResource HomeHint}"/><TextBlock x:Name="JunkSizeText" Text="—" FontSize="36" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,3,0,4"/><TextBlock x:Name="JunkNoteText" Text="{DynamicResource ui.home.scan.review}" Style="{StaticResource HomeHint}"/>
      <WrapPanel Margin="0,14,0,0"><Button x:Name="BtnScan" Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,12,2" Click="BtnScan_Click"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ScanIcon}" Stroke="White" StrokeThickness="1.8" Width="15" Height="15" Stretch="Uniform" Margin="0,0,7,0"/><TextBlock Text="{DynamicResource btn.scan.now}"/></StackPanel></Button><Button x:Name="BtnQuickClean" Content="{DynamicResource ui.quick.title}" ToolTip="{DynamicResource ui.quick.description}" Style="{StaticResource SmallSecondaryButton}" Padding="12,8" Margin="0,0,12,2" Click="BtnQuickClean_Click"/><Button x:Name="BtnReview" Style="{StaticResource LinkButton}" Padding="0,8" Margin="0,0,0,2" Click="CardJunk_Click" Content="{DynamicResource ui.home.review.items}"/></WrapPanel>
     </StackPanel>
     <Border x:Name="MonitorPanel" Grid.Column="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0" Padding="20,0,0,0"><StackPanel>
      <DockPanel Margin="0,0,0,12"><Ellipse DockPanel.Dock="Right" Width="5" Height="5" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" ToolTip="{DynamicResource home.mon.live}"/><TextBlock Text="{DynamicResource home.mon.title}" Style="{StaticResource HomeLabel}" FontWeight="SemiBold"/></DockPanel>
      <DockPanel><TextBlock x:Name="CpuPercentText" DockPanel.Dock="Right" Text="—" Style="{StaticResource HomeLabel}"/><TextBlock x:Name="CpuLabel" Text="{DynamicResource home.mon.cpu}" Style="{StaticResource HomeHint}"/></DockPanel>
      <ProgressBar x:Name="CpuBar" Maximum="100" Height="4" Margin="0,6,0,12" AutomationProperties.Name="{DynamicResource home.mon.cpu}"/>
      <DockPanel><TextBlock x:Name="RamPercentText" DockPanel.Dock="Right" Text="—" Style="{StaticResource HomeLabel}" Margin="8,0,0,0"/><WrapPanel><TextBlock Text="{DynamicResource home.mon.ram}" Style="{StaticResource HomeHint}"/><TextBlock x:Name="RamDetailText" Text="—" Style="{StaticResource HomeHint}" Margin="8,0,0,0"/></WrapPanel></DockPanel>
      <ProgressBar x:Name="RamBar" Maximum="100" Height="4" Margin="0,6,0,12" AutomationProperties.Name="{DynamicResource home.mon.ram}"/>
      <DockPanel><TextBlock x:Name="UptimeText" DockPanel.Dock="Right" Text="—" Style="{StaticResource HomeHint}" Margin="8,0,0,0"/><TextBlock Text="{DynamicResource home.mon.uptime}" Style="{StaticResource HomeHint}"/></DockPanel>
     </StackPanel></Border>
    </Grid>
   </Border>
   <StackPanel x:Name="ShortcutRows" Margin="0,7,0,10">
    <Button x:Name="StartupShortcut" Style="{StaticResource HomeRow}" Click="CardStartup_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
     <Border Width="28" Height="28" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="7" HorizontalAlignment="Left"><Path Data="{StaticResource PowerIcon}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform"/></Border><TextBlock Grid.Column="1" Text="{DynamicResource home.card.startup}" Style="{StaticResource HomeLabel}" Margin="0,0,18,0"/><TextBlock x:Name="StartupNoteText" Grid.Column="2" Style="{StaticResource HomeHint}" Text="{DynamicResource home.card.startup.note}" Margin="0,0,12,0"/><TextBlock x:Name="StartupCountText" Grid.Column="3" Text="—" Style="{StaticResource HomeLabel}"/><TextBlock Grid.Column="4" Text="›" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid></Button><Border Height="1" Background="{DynamicResource DividerBrush}"/>
    <Button x:Name="LargeShortcut" Style="{StaticResource HomeRow}" Click="CardLarge_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
     <Border Width="28" Height="28" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="7" HorizontalAlignment="Left"><Path Data="{StaticResource FileIcon}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform"/></Border><TextBlock Grid.Column="1" Text="{DynamicResource home.card.large}" Style="{StaticResource HomeLabel}" Margin="0,0,18,0"/><TextBlock x:Name="LargeNoteText" Grid.Column="2" Style="{StaticResource HomeHint}" Text="{DynamicResource home.card.large.note}" Margin="0,0,12,0"/><TextBlock x:Name="LargeCountText" Grid.Column="3" Text="—" Style="{StaticResource HomeLabel}"/><TextBlock Grid.Column="4" Text="›" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid></Button><Border Height="1" Background="{DynamicResource DividerBrush}"/>
    <Button x:Name="AppsShortcut" Style="{StaticResource HomeRow}" Click="CardApps_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions>
     <Border Width="28" Height="28" Background="{DynamicResource PrimarySoftBrush}" CornerRadius="7" HorizontalAlignment="Left"><Path Data="{StaticResource BoxIcon}" Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform"/></Border><TextBlock Grid.Column="1" Text="{DynamicResource nav.apps}" Style="{StaticResource HomeLabel}" Margin="0,0,18,0"/><TextBlock Grid.Column="2" Text="{DynamicResource home.card.apps.note}" Style="{StaticResource HomeHint}" Margin="0,0,12,0"/><TextBlock x:Name="AppsCountText" Grid.Column="3" Text="—" Style="{StaticResource HomeLabel}"/><TextBlock Grid.Column="4" Text="›" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid></Button>
   </StackPanel>
   <Border x:Name="DiskCard" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14,12"><StackPanel>
    <DockPanel Margin="0,0,0,12"><Button x:Name="AnalyzeShortcut" DockPanel.Dock="Right" Content="{DynamicResource nav.space}" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Click="BtnAnalyze_Click" Margin="12,0,0,0"/><WrapPanel><TextBlock x:Name="DiskTitle" Text="{DynamicResource ui.home.disk}" Style="{StaticResource HomeLabel}" FontWeight="SemiBold" Margin="0,0,12,0"/><WrapPanel x:Name="DriveChipHost"/></WrapPanel></DockPanel>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="DiskFreeText" Text="—" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/><TextBlock x:Name="DiskUsedText" Grid.Column="1" Text="—" Style="{StaticResource HomeHint}" HorizontalAlignment="Right" TextAlignment="Right" Margin="12,0,0,0"/></Grid>
    <ProgressBar x:Name="DiskUsageBar" Maximum="100" Height="6" AutomationProperties.Name="{DynamicResource ui.home.disk}"/>
    <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="DiskPercentText" Text="—" Style="{StaticResource HomeHint}"/><TextBlock x:Name="DiskNoteText" Grid.Column="1" Text="{DynamicResource ui.home.disk.note}" Style="{StaticResource HomeHint}" TextAlignment="Right" Margin="12,0,0,0"/></Grid>
   </StackPanel></Border>
   <DockPanel Margin="0,14,0,10"><Button x:Name="HistoryShortcut" DockPanel.Dock="Right" Content="{DynamicResource common.viewall}" Style="{StaticResource LinkButton}" VerticalAlignment="Center" Click="BtnHistory_Click" Margin="18,0,0,0"/><StackPanel><TextBlock Text="{DynamicResource home.activity.title}" Style="{StaticResource HomeLabel}" FontWeight="SemiBold"/><TextBlock x:Name="RecentActivityText" Text="{DynamicResource home.activity.empty}" Style="{StaticResource HomeHint}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/></StackPanel></DockPanel>
   <Expander x:Name="DetailsExpander" Header="{DynamicResource ui.home.details}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Expanded="Details_Expanded" Collapsed="Details_Collapsed"><StackPanel Margin="0,12,0,0">
    <TextBlock Text="{DynamicResource home.space.title}" Style="{StaticResource HomeLabel}" FontWeight="SemiBold"/><TextBlock x:Name="AnalysisNote" Style="{StaticResource HomeHint}" Margin="0,4,0,8"/><TextBlock x:Name="AnalysisEmpty" Text="{DynamicResource home.space.empty}" Style="{StaticResource HomeHint}"/>
    <ItemsControl x:Name="CategoryList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" Style="{StaticResource HomeLabel}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource HomeHint}" Margin="12,0,0,0"/><TextBlock Grid.Column="2" Text="{Binding PercentText}" Style="{StaticResource HomeHint}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Border Style="{StaticResource Divider}"/><TextBlock Text="{DynamicResource home.stats.days7}" Style="{StaticResource HomeLabel}" FontWeight="SemiBold"/><TextBlock x:Name="StatsTotalText" Style="{StaticResource HomeHint}" Margin="0,4,0,4"/><UniformGrid x:Name="StatsBars" Columns="7" Height="42" Margin="0,4,0,0"/>
    <Border Style="{StaticResource Divider}"/><TextBlock Text="{DynamicResource home.suggest.title}" Style="{StaticResource HomeLabel}" FontWeight="SemiBold"/>
    <ItemsControl x:Name="SuggestList" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><DockPanel Margin="0,6"><Button DockPanel.Dock="Right" Content="{Binding ActionText}" Style="{StaticResource SmallSecondaryButton}" Tag="{Binding}" Click="SuggestAction_Click" VerticalAlignment="Center" Margin="14,0,0,0"/><StackPanel><TextBlock Text="{Binding Name}" Style="{StaticResource HomeLabel}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SizeText}" Style="{StaticResource HomeHint}"/><TextBlock Text="{Binding Note}" Style="{StaticResource HomeHint}"/></StackPanel></DockPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock x:Name="NoSuggestText" Text="{DynamicResource home.suggest.empty}" Style="{StaticResource HomeHint}" Margin="0,6,0,0"/>
   </StackPanel></Expander>
  </StackPanel>
 </ScrollViewer>
</Page>

<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CleanOptimize.App.Pages.SpaceAnalysisPage" FontFamily="Microsoft YaHei UI">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <!-- 头部 -->
    <Grid Grid.Row="0" Margin="4,2,4,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{DynamicResource nav.space}" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        <ComboBox x:Name="DriveSelector" Width="150" Margin="20,0,0,0" SelectionChanged="DriveSelector_Changed"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Row="1" Margin="0,18,0,0">
        <RadioButton x:Name="TabOverview" Content="{DynamicResource space.tab.overview}" Style="{StaticResource PillTab}" GroupName="satabs" IsChecked="True" Checked="OverviewTab_Checked"/>
        <RadioButton x:Name="TabLarge" Content="{DynamicResource space.tab.large}" Style="{StaticResource PillTab}" GroupName="satabs" Checked="LargeTab_Checked"/>
        <Button x:Name="BtnAnalyze" Content="{DynamicResource btn.analyze.start}" Style="{StaticResource PrimaryButton}" Padding="20,8" Margin="14,0,0,0" Click="BtnAnalyze_Click"/>
      </StackPanel>
    </Grid>
    <!-- 概览条 -->
    <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="2,14,2,0" Padding="20,16" x:Name="OverviewCard">
      <Grid>
        <StackPanel>
          <Grid>
            <StackPanel Orientation="Horizontal">
              <TextBlock x:Name="OverviewDriveText" Text="C:" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
              <TextBlock x:Name="OverviewUsedText" Text="" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>
            <TextBlock x:Name="OverviewTimeText" Text="" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <ProgressBar x:Name="DiskUsageBar" Height="8" Margin="0,14,0,0" Maximum="100" Foreground="{DynamicResource PrimaryBrush}"/>
          <WrapPanel x:Name="CategoryRow" Margin="0,14,0,0"/>
          <TextBlock x:Name="OverviewEmptyText" Text="{DynamicResource space.empty}" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,8,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <!-- 内容 -->
    <Grid Grid.Row="2" Margin="2,14,2,0">
      <!-- 分析进度覆盖 -->
      <Border x:Name="AnalyzePanel" Style="{StaticResource CardBorder}" Padding="30,24" Visibility="Collapsed" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="{DynamicResource space.scanning}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock x:Name="AnalyzeDirText" Text="" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,10,0,0"/>
          <ProgressBar x:Name="AnalyzeBar" IsIndeterminate="True" Height="6" Margin="0,14,0,0"/>
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock x:Name="AnalyzeFilesText" Text="" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="AnalyzeBytesText" Text="" FontSize="12.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="18,0,0,0" VerticalAlignment="Center"/>
            <Button x:Name="BtnCancelAnalyze" Content="{DynamicResource btn.cancel}" Style="{StaticResource SmallSecondaryButton}" Margin="20,0,0,0" Click="BtnCancelAnalyze_Click"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <!-- 概览：目录树 -->
      <Border x:Name="TreeCard" Style="{StaticResource CardBorder}" Padding="10,10" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
          </Grid.ColumnDefinitions>
          <Grid Grid.Row="0" Margin="14,6,14,8">
            <TextBlock Text="{DynamicResource space.tree.title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="{DynamicResource space.tree.hint}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>
          <TreeView Grid.Row="1" x:Name="FolderTree" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource FolderTreeItem}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectedItemChanged="FolderTree_SelectedItemChanged" Margin="0,0,14,0">
            <TreeView.ItemTemplate>
              <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                <Grid Margin="0,3" MinWidth="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="0"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                  <ProgressBar Grid.Column="1" Value="{Binding Percent}" Maximum="100" Height="6" Margin="10,0,14,0" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryBrush}" Opacity="0.8"/>
                  <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="3" Text="{Binding CountText}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" Visibility="Collapsed"/>
                </Grid>
              </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
          <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource SidebarBgBrush}" CornerRadius="8" Padding="16" VerticalAlignment="Top">
            <StackPanel>
 <TextBlock x:Name="FolderDetailName" Text="{DynamicResource ui.select.folder}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
 <TextBlock x:Name="FolderDetailSize" FontSize="25" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0"/>
 <TextBlock x:Name="FolderDetailPath" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
 <Button x:Name="FolderOpen" Content="{DynamicResource ctx.openloc}" Style="{StaticResource SecondaryButton}" IsEnabled="False" Margin="0,18,0,0" Click="FolderOpen_Click"/>
 <TextBlock Text="{DynamicResource ui.folder.note}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
 </StackPanel>
          </Border>
        </Grid>
      </Border>
      <!-- 大文件 -->
      <Border x:Name="LargeCard" Style="{StaticResource CardBorder}" Padding="16,14" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
          </Grid.ColumnDefinitions>
          <Grid Grid.Row="0" Margin="6,2,6,10" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{DynamicResource space.tab.large}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
              <TextBlock x:Name="LargeSummaryText" Text="" FontSize="11.5" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Margin="12,0,0,0"/>
              <TextBlock Text="{DynamicResource space.large.filter}" FontSize="12" VerticalAlignment="Center" Margin="24,0,8,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
              <ComboBox x:Name="LargeThreshold" Width="120" SelectionChanged="LargeThreshold_Changed">
                <ComboBoxItem Content="&gt; 500 MB" Tag="500" IsSelected="True"/>
                <ComboBoxItem Content="&gt; 1 GB" Tag="1000"/>
                <ComboBoxItem Content="&gt; 5 GB" Tag="5000"/>
              </ComboBox>
            </StackPanel>
            <TextBlock Text="{DynamicResource space.large.hint}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
          </Grid>
          <WrapPanel Grid.Row="1" x:Name="TypeFilterHost" Margin="6,0,6,10" Grid.ColumnSpan="2"/>
          <controls:VirtualRows xmlns:controls="clr-namespace:CleanOptimize.App.Controls" x:Name="LargeList" Grid.Row="2" SelectionChanged="LargeList_SelectionChanged" Margin="0,0,14,0"/>
          <TextBlock x:Name="LargeEmptyText" Text="{DynamicResource space.empty}" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="2"/>
          <Border Grid.Row="2" Grid.Column="1" Background="{DynamicResource SidebarBgBrush}" CornerRadius="8" Padding="16" VerticalAlignment="Top">
            <StackPanel>
 <TextBlock x:Name="FileDetailName" Text="{DynamicResource ui.select.file}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
 <TextBlock x:Name="FileDetailMeta" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,14,0,0" TextWrapping="Wrap"/>
 <StackPanel x:Name="FileActions" IsEnabled="False" Margin="0,14,0,0">
 <Button Content="{DynamicResource ctx.openloc}" Style="{StaticResource SecondaryButton}" Click="FileOpen_Click"/>
 <Button Content="{DynamicResource space.addwhitelist}" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="FileWhitelist_Click"/>
 <Button Content="{DynamicResource btn.recycle}" Style="{StaticResource DangerGhostButton}" Margin="0,8,0,0" Click="FileRecycle_Click"/>
 </StackPanel></StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- ===== 浅色主题画刷（默认） ===== -->
  <Color x:Key="PrimaryColor">#2774F0</Color>
  <SolidColorBrush x:Key="PrimaryBrush" Color="#3575E8"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#3F86F5"/>
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#1D5FD0"/>
  <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#3B87F8" Offset="0"/>
    <GradientStop Color="#1E64DC" Offset="1"/>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EAF1FF"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#2CB7A5"/>
  <SolidColorBrush x:Key="WindowBgBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="PageBgBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SidebarBgBrush" Color="#F6F8FB"/>
  <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="CardBorderBrush" Color="#E9EDF3"/>
  <SolidColorBrush x:Key="NavActiveBgBrush" Color="#EAF1FF"/>
  <SolidColorBrush x:Key="NavHoverBgBrush" Color="#F2F6FD"/>
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#202A3A"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#657287"/>
  <SolidColorBrush x:Key="TextTertiaryBrush" Color="#657287"/>
  <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="FocusRingBrush" Color="#8FB2F4"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#1B8F4B"/>
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E6F6EB"/>
  <SolidColorBrush x:Key="WarningBrush" Color="#C05E00"/>
  <SolidColorBrush x:Key="WarningSoftBrush" Color="#FCF3E5"/>
  <SolidColorBrush x:Key="DangerBrush" Color="#CC3D3D"/>
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#FBEAEA"/>
  <SolidColorBrush x:Key="OrangeBrush" Color="#C2410C"/>
  <SolidColorBrush x:Key="PurpleBrush" Color="#8B5CF6"/>
  <SolidColorBrush x:Key="TealBrush" Color="#0D9488"/>
  <SolidColorBrush x:Key="PinkBrush" Color="#EC4899"/>
  <SolidColorBrush x:Key="DividerBrush" Color="#EDF1F8"/>
  <SolidColorBrush x:Key="TrackBrush" Color="#E4EAF4"/>
  <Color x:Key="SkeletonColor">#E7EDF7</Color>
  <SolidColorBrush x:Key="OverlayBrush" Color="#8A000000"/>
  <SolidColorBrush x:Key="ItemHoverBrush" Color="#F4F8FF"/>
  <SolidColorBrush x:Key="ItemPressedBrush" Color="#EAF2FF"/>
  <SolidColorBrush x:Key="ShadowBrush" Color="#14274A85"/>
  <SolidColorBrush x:Key="TooltipBgBrush" Color="#FFFFFF"/>

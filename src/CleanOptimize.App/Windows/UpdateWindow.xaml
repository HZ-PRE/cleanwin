<Window x:Class="CleanOptimize.App.Windows.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ui.update.title}" Width="500" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource CardBgBrush}">
  <StackPanel Margin="24">
    <TextBlock x:Name="VersionMessage" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
    <TextBlock Text="{DynamicResource ui.update.description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="0,12,0,0"/>
    <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,16,0,0"/>
    <ProgressBar x:Name="DownloadProgress" Maximum="100" Height="5" Margin="0,10,0,0" Visibility="Collapsed"/>
    <WrapPanel HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button x:Name="CancelButton" Content="{DynamicResource btn.cancel}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,6" Click="Cancel_Click"/>
      <Button x:Name="ConfirmButton" Content="{DynamicResource ui.update.confirm}" Style="{StaticResource PrimaryButton}" Margin="0,0,0,6" Click="Confirm_Click"/>
    </WrapPanel>
  </StackPanel>
</Window>
